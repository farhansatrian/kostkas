# =============================================================================
# KostKas — Contoh Konfigurasi Environment (.env.example)
# =============================================================================
# Salin file ini menjadi `.env.local` saat pengembangan fitur backend dimulai.
# JANGAN PERNAH mengisi kredensial asli, PIN, atau token rahasia di file ini!

NEXT_PUBLIC_APP_NAME="KostKas"
NEXT_PUBLIC_APP_ENV="development"

# Parameter default awal (dapat diubah secara dinamis di sistem nantinya)
NEXT_PUBLIC_DEFAULT_MONTHLY_DUE="150000"

