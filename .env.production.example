# =============================================================================
# KostKas — Template Konfigurasi Environment Production (.env.production.example)
# =============================================================================
# Server VM Target: kebonkacang (Alpine Linux, 2 vCPU, 1 GB RAM, 10 GB Disk)
# IP Privat: 10.211.84.117 | Domain Publik: vm-kebonkacang.supercomfy.dev
# Port Forwarding Gateway Dashboard: 3000
#
# Salin file ini menjadi `.env.production` di server VM:
#   cp .env.production.example .env.production
# JANGAN PERNAH menyimpan kredensial asli ke dalam Git repository publik!
# =============================================================================

# Identitas Aplikasi & Image Container
NEXT_PUBLIC_APP_NAME="KostKas"
NEXT_PUBLIC_APP_ENV="production"
NEXT_PUBLIC_DEFAULT_MONTHLY_DUE="150000"

# Image GHCR Prebuilt (Di-build oleh GitHub Actions CI/CD)
# Tag image dapat menggunakan commit SHA (contoh: ghcr.io/farhansatrian/kostkas:33e597a) atau 'latest'
KOSTKAS_IMAGE="ghcr.io/farhansatrian/kostkas:latest"

# Antarmuka Binding Port Host Container Next.js:
# - "0.0.0.0" (default): Menerima koneksi dari semua interface, sehingga gateway
#   dashboard platform yang meneruskan port 3000 ke IP privat (10.211.84.117)
#   dapat terhubung dengan sukses.
# - "10.211.84.117": Mengikat khusus ke IP privat VM.
# - "127.0.0.1": Hanya jika reverse proxy berjalan lokal di dalam host yang sama.
APP_BIND_IP="0.0.0.0"

# Kredensial Database PostgreSQL (Internal Docker Network)
# Generate password kuat (minimal 32 karakter acak), contoh perintah di Alpine/Linux:
#   openssl rand -base64 32 | tr -dc 'a-zA-Z0-9' | head -c 32; echo
POSTGRES_USER="kostkas_admin"
POSTGRES_PASSWORD="GANTI_DENGAN_PASSWORD_DATABASE_KUAT_ACAK"
POSTGRES_DB="kostkas_prod_db"

# URL Koneksi PostgreSQL Internal (Host 'db' pada internal Docker network 'kostkas-prod-net')
# CATATAN: Port 5432 tidak diekspos ke host maupun internet publik.
DATABASE_URL="postgresql://kostkas_admin:GANTI_DENGAN_PASSWORD_DATABASE_KUAT_ACAK@db:5432/kostkas_prod_db?schema=public"

# Kunci Rahasia Enkripsi & Penandatanganan Sesi (AUTH_SECRET)
# WAJIB minimal 64 karakter acak untuk keamanan kriptografi HS256:
#   openssl rand -hex 32
AUTH_SECRET="GANTI_DENGAN_KUNCI_ACAK_HEX_MINIMAL_64_KARAKTER"

# Kontrol Migrasi Otomatis Saat Startup Container (true/false)
RUN_MIGRATIONS="true"

# Keamanan Cookie Sesi (true/false):
# - Set "true" (default): Jika diakses melalui domain HTTPS (https://vm-kebonkacang.supercomfy.dev).
# - Set "false": Hanya jika diuji langsung via HTTP polos (misal http://10.211.84.117:3000 tanpa TLS).
COOKIE_SECURE="true"

# Token Rahasia Inisialisasi Akun Pertama (INITIAL_SETUP_TOKEN)
# Digunakan satu kali pada web /login saat database baru pertama kali diinisialisasi.
# Mencegah pengguna yang tidak berwenang membuat akun pertama (anti first-to-claim race condition).
# Generate token acak (minimal 32 karakter hex):
#   openssl rand -hex 16
INITIAL_SETUP_TOKEN="GANTI_DENGAN_TOKEN_SETUP_ACAK_MINIMAL_32_HEX"
