# =============================================================================
# KostKas — Contoh Konfigurasi Environment (.env.example)
# =============================================================================
# Salin file ini menjadi `.env` untuk pengembangan lokal.
# JANGAN PERNAH mengisi kredensial asli, PIN, atau password rahasia di file ini!

NEXT_PUBLIC_APP_NAME="KostKas"
NEXT_PUBLIC_APP_ENV="development"
NEXT_PUBLIC_DEFAULT_MONTHLY_DUE="150000"

# Konfigurasi PostgreSQL (Docker Compose — Port Lokal 127.0.0.1:5433)
POSTGRES_USER="kostkas_app"
POSTGRES_PASSWORD="GANTI_DENGAN_PASSWORD_LOKAL_YANG_KUAT"
POSTGRES_DB="kostkas_db"
POSTGRES_TEST_DB="kostkas_test_db"
POSTGRES_PORT="5433"

# URL Koneksi Database untuk aplikasi / ORM nantinya
DATABASE_URL="postgresql://kostkas_app:GANTI_DENGAN_PASSWORD_LOKAL_YANG_KUAT@127.0.0.1:5433/kostkas_db?schema=public"

# URL Koneksi Database Terisolasi khusus Automated Tests (Wajib berbeda dari DATABASE_URL)
TEST_DATABASE_URL="postgresql://kostkas_app:GANTI_DENGAN_PASSWORD_LOKAL_YANG_KUAT@127.0.0.1:5433/kostkas_test_db?schema=public"

# Kunci rahasia enkripsi/penandatanganan sesi autentikasi (minimal 32 karakter acak)
AUTH_SECRET="GANTI_DENGAN_KUNCI_ACAK_MINIMAL_32_KARAKTER"

# Password awal development untuk akun seed lokal (hanya untuk .env lokal, jangan diisi password asli di sini)
KOSTKAS_DEV_INITIAL_PASSWORD="GANTI_DENGAN_PASSWORD_DEV_LOKAL_MIN_8_KARAKTER"
